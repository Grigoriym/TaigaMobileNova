{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "prHourlyLimit": 3,
    "baseBranchPatterns": [
        "dev"
    ],
    "osvVulnerabilityAlerts": true,
    "packageRules": [
        {
            "description": "kotlinx-datetime's -0.6.x-compat builds are a compatibility variant for 0.6.x-era consumers, not newer releases.",
            "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-datetime"],
            "allowedVersions": "!/-compat$/"
        }
    ]
}
